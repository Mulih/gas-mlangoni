// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String    @id @default(uuid())
  phone     String    @unique
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")

  addresses  Address[]

  @@map("customers")
}

// One delivery address belonging to a customer. A customer can have more
// than one (home, office, etc.), so this is its own table rather than
// columns bolted onto Customer - that's what makes it a one-to-many
// relationship instead of a one-to-one
model Address {
  // Same UUID primary key pattern as Customer, and the same reasoning:
  // can be generated before the row is inserted, and doesn't reveal how
  // many addresses exist by its value (unlike a sequential integer).
  id  String  @id @default(uuid())

  // The actual foreign key column stored in the database - this is a
  // plain string colunm holding the id of the Customer this address
  // belongs to. Nothing special about it on its own; the next field is
  // what turns it into an enforced relationship.
  customerId  String @map("customer_id")

  // The relation field. This does NOT create a column in the databse -
  // it tells Prisma how to link Address to Customer so your code can
  // write `address.customer.phone` instead of a manual second query and 
  // it tell Postgres to enforce the relationship: `fields: [customerId]`
  // is the column on THIS model, `references: [id]` is the column on
  // Customer it must match. Postgres will now reject and Address row
  // whose customerId doesn't correspond to a real Customer.
  customer Customer @relation(fields: [customerId], references: [id])

  // Straight from the registration use case: Kentan urban addressing is
  //estate name + a GPS pin, not a Western-styyle postal address - so
  // that's what we store not a generic street address field that
  // wouldn't actually match how anyone will fill this in.
  estateName  String  @map("estate_name")
  gpsLat      Float   @map("gps_lat")
  gpsLng      Float   @map("gps_lng")


// Speeds up the single most common query on this table - "find actually
// addresses belonging to this customer" - by letting Postgres jump
 // straight to mathcing rows instead of scanning the whole table.
 // Without this, customer_id has a foreign key constraint (enforcing
 // correctness) but no index (enforcing speed) - two separate things
 // that are easy to mix up as one.
 @@index([customerId])

  // Same snake_case-table-name convention as Customer - keeps the actual
  // SQL looking like normal SQL, not like JavaScript.
  @@map("addresses")
}

// A licensed LPG dealer/depot. Distinct from Customer and Rider because
// its job is completely different: stocking cylinders and getting
// verified against EPRA's liccensing requirement, not ordering ordering
// delivering anything.
model Vendor {
  id           String  @id @default(uuid())
  businessName String  @map("business_name")

  // Optional: a vendor can exist in a "just signed up, hasn't submitted
  // a permit yet" state, so this can't be required at creation time.
  epraPermitNumber  String? @map("epra_permit_number")

  // This is an enum, not a plain string, first one in the schema. An 
  // enum restricts this column, at the database level, to only the exact
  // values defined below. typos or wrong case become physically impossible 
  // to store, not just discouraged by convention
  permitStatus PermitStatus @default(PENDING) @map("permit_status")

  // Nullable because a PENDING vendor has no expiry date yet. One only
  // gets set once a real permit has actually been reviewed.
  permitExpiry DateTime? @map("permit_expiry")

  createdAt DateTime @default(now()) @map("created_at")

  inventory InventoryStock[]

  @@map("vendors")
}

// Referenced by Vendor above. There is no live verification API, so this status 
// is always set by a human admin reviewing an uploaded document, never automatically.
// PENDING is the only calid starting state, matching the @default above.
enum PermitStatus {
  PENDING
  VERIFIED 
  REJECTED
  EXPIRED
}

// The platform-wide price for a given cylinder brand+size. Set once,
// by the platform, not by individual vendors. This is to avoid vendors
// undercutting or overcharging.
model CylinderPrice {
  id    String @id @default(uuid())
  brand String
  size  String
  price Decimal @db.Decimal(10, 2)
  @@unique([brand, size])

  @@map("cylinder_prices")
}

// Tracks how many cylinders for a given brand+size a vendor has in stock,
// and what they charge for it. One row per (vendor, brand, size)
// combination. We are tracking levels, not individual
// cylinders
model InventoryStock {
  id        String @id @default(uuid())
  vendorId  String @map("vendor_id")
  vendor    Vendor @relation(fields: [vendorId], references: [id])
  brand     String
  size      String
  quantity  Int    @default(0)

  @@unique([vendorId, brand, size])
  @@index([vendorId])
  @@map("inventory_stock")
}

// A delivery rider. Deliberately no relation to Order yet

model Rider {
  id    String @id @default(uuid())
  name  String

  // Unique for the same reason as Customer.phone: this is how a rider
  // identifies themselves logging into the Rider App, so the database
  // must refuse a duplicate, not just discourage one.
  phone  String @unique

  // Enum, not a plain string, same reasoning as PermitStatus. Dispatch
  // logic (UC-08) will directly depend on this value to find the 
  // nearest AVAILABLE rider," so a typo'd or invalid status here isn't 
  // just messy data, it's a rider who silently never received a job.
  status RiderStatus @default(OFFLINE)

  @@map("riders")
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}